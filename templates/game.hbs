{{#if hasGame}}
<div class="bb-container">

  <div class="bb-header">
    <div class="bb-title"><i class="fas fa-dice"></i><span>Baldur's Bones</span></div>
    {{#if isSetup}}{{else}}
    <div class="bb-pot-display"><i class="fas fa-coins"></i><span class="bb-pot-amount">{{pot}} gp</span></div>
    {{/if}}
  </div>

  {{!-- ═══ SETUP ═══ --}}
  {{#if isSetup}}
  <div class="bb-setup">
    <div class="bb-setup-panel">
      <div class="bb-setup-field">
        <label for="bb-ante-input"><i class="fas fa-coins"></i> Ante</label>
        <div class="bb-ante-wrap">
          <input type="number" id="bb-ante-input" value="{{ante}}" min="0" step="1" {{#unless isGM}}disabled{{/unless}} />
          <span class="bb-ante-unit">gp</span>
        </div>
      </div>
      {{#if isGM}}
      <div class="bb-setup-field">
        <label for="bb-actor-search"><i class="fas fa-user-plus"></i> Add Player</label>
        <div class="bb-add-col">
          <input type="text" id="bb-actor-search" placeholder="Search…" class="bb-search-input" autocomplete="off" />
          <div class="bb-add-row">
            <select id="bb-actor-select">
              <option value="">— Choose —</option>
              {{#each availableActors}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
            </select>
            <button data-action="add-player" class="bb-btn bb-btn-add"><i class="fas fa-plus"></i></button>
          </div>
        </div>
      </div>
      {{/if}}
    </div>
    {{#if players.length}}
    <div class="bb-roster">
      <div class="bb-roster-header">Players at the Table</div>
      {{#each players}}
      <div class="bb-roster-row">
        <img src="{{this.img}}" alt="{{this.name}}" class="bb-avatar" />
        <span class="bb-roster-name">{{this.name}}</span>
        {{#if this.isNPC}}<span class="bb-tag bb-tag-npc">NPC</span>{{/if}}
        {{#if this.isHost}}<span class="bb-tag bb-tag-host">HOST</span>{{/if}}
        {{#if ../isGM}}<button data-action="remove-player" data-actor-id="{{this.actorId}}" class="bb-btn-remove"><i class="fas fa-times"></i></button>{{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{#if isGM}}<button data-action="start-game" class="bb-btn bb-btn-start"><i class="fas fa-play"></i> Deal the Bones</button>
    {{else}}<p class="bb-waiting"><i class="fas fa-hourglass-half"></i> Waiting for the host…</p>{{/if}}
  </div>
  {{/if}}

  {{!-- ═══ ROUND TABLE ═══ --}}
  {{#if isTablePhase}}
  <div class="bb-table">

    <div class="bb-round-table">
      <div class="bb-table-surface">
        <div class="bb-coin-pile">
          {{#each coins}}<div class="bb-coin"></div>{{/each}}
        </div>
        <div class="bb-table-pot"><i class="fas fa-coins"></i> {{pot}} gp</div>
      </div>
      {{#each players}}
      <div class="bb-card {{#if this.isCurrent}}bb-active{{/if}} {{#if this.isBust}}bb-bust{{/if}} {{#if this.isStanding}}bb-standing{{/if}} {{#if this.isWinner}}bb-winner{{/if}}"
           style="left:{{this.posX}}%; top:{{this.posY}}%;">
        <div class="bb-card-top">
          <img src="{{this.img}}" alt="{{this.name}}" class="bb-avatar-sm" />
          <span class="bb-card-name">{{this.name}}</span>
        </div>
        <div class="bb-card-tags">
          {{#if this.isHost}}<span class="bb-tag bb-tag-host">HOST</span>{{/if}}
          {{#if this.isBust}}<span class="bb-tag bb-tag-bust">BUST</span>{{/if}}
          {{#if this.isStanding}}<span class="bb-tag bb-tag-stand">STAND</span>{{/if}}
          {{#if this.isWinner}}<span class="bb-tag bb-tag-winner">WIN</span>{{/if}}
        </div>
        <div class="bb-dice-tray">
          {{#each this.diceValues}}<div class="bb-die bb-die-{{this}}"><div class="bb-pips"></div></div>{{/each}}
        </div>
        <div class="bb-score">{{this.total}}</div>
      </div>
      {{/each}}
    </div>

    {{!-- ── INITIAL ROLL ── --}}
    {{#if isInitialRoll}}
    <div class="bb-action-bar">
      {{#if canAct}}
      <div class="bb-turn-prompt">{{currentPlayerName}} — roll your starting bones!</div>
      <div class="bb-action-buttons">
        <button data-action="initial-roll" data-actor-id="{{currentActorId}}" class="bb-btn bb-btn-roll"><i class="fas fa-dice"></i> Roll 3d6</button>
        {{#if isGM}}<button data-action="forfeit" class="bb-btn bb-btn-forfeit"><i class="fas fa-ban"></i> End Round</button>{{/if}}
      </div>
      {{else if currentIsNPC}}
      <div class="bb-turn-prompt bb-npc-thinking"><i class="fas fa-dice bb-spin"></i> {{currentPlayerName}} is rolling…</div>
      {{#if isGM}}<div class="bb-action-buttons"><button data-action="forfeit" class="bb-btn bb-btn-forfeit"><i class="fas fa-ban"></i> End Round</button></div>{{/if}}
      {{else}}
      <div class="bb-turn-prompt">Waiting for {{currentPlayerName}} to roll…</div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── PLAYING ── --}}
    {{#if isPlaying}}
    <div class="bb-action-bar">
      {{#if canAct}}
      <div class="bb-turn-prompt">{{currentPlayerName}}'s turn</div>
      <div class="bb-action-buttons" id="bb-normal-actions">
        <button data-action="roll" data-actor-id="{{currentActorId}}" class="bb-btn bb-btn-roll"><i class="fas fa-dice"></i> Roll</button>
        <button data-action="stand" data-actor-id="{{currentActorId}}" class="bb-btn bb-btn-stand"><i class="fas fa-hand"></i> Stand</button>
        {{#if canCheat}}<button data-action="cheat" class="bb-btn bb-btn-cheat" title="Sleight of Hand"><i class="fas fa-hand-sparkles"></i></button>{{/if}}
        {{#if isGM}}<button data-action="forfeit" class="bb-btn bb-btn-forfeit"><i class="fas fa-ban"></i></button>{{/if}}
      </div>
      <div class="bb-cheat-picker" id="bb-cheat-picker" style="display:none">
        <div class="bb-cheat-label">Pick your number:</div>
        <div class="bb-cheat-dice">
          {{#each (array 1 2 3 4 5 6)}}
          <button data-action="cheat-pick" data-actor-id="{{../currentActorId}}" data-value="{{this}}" class="bb-die-btn bb-die bb-die-{{this}}"><div class="bb-pips"></div></button>
          {{/each}}
        </div>
        <button data-action="cancel-cheat" class="bb-btn bb-btn-cancel">Cancel</button>
      </div>
      {{else if currentIsNPC}}
      <div class="bb-turn-prompt bb-npc-thinking"><i class="fas fa-dice bb-spin"></i> {{currentPlayerName}} is pondering the bones…</div>
      {{#if isGM}}<div class="bb-action-buttons"><button data-action="forfeit" class="bb-btn bb-btn-forfeit"><i class="fas fa-ban"></i> End Round</button></div>{{/if}}
      {{else}}
      <div class="bb-turn-prompt">Waiting for {{currentPlayerName}}…</div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── RESOLUTION ── --}}
    {{#if isResolution}}
    <div class="bb-result-bar">
      {{#if winnerImg}}
      <div class="bb-winner-spotlight">
        <img src="{{winnerImg}}" alt="{{winnerName}}" class="bb-winner-portrait" />
      </div>
      {{/if}}
      {{#if (bbeq winnerId 'tie')}}<div class="bb-result-msg"><i class="fas fa-handshake"></i> Push — pot split!</div>
      {{else if winnerId}}<div class="bb-result-msg"><i class="fas fa-trophy"></i> {{winnerName}} takes the pot!</div>
      {{else}}<div class="bb-result-msg"><i class="fas fa-skull-crossbones"></i> Everyone busted! House wins.</div>{{/if}}
      {{#if isGM}}
      <div class="bb-action-buttons">
        <button data-action="play-again" class="bb-btn bb-btn-again"><i class="fas fa-redo"></i> Play Again</button>
        <button data-action="end-game" class="bb-btn bb-btn-end"><i class="fas fa-times"></i> End Game</button>
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{#if roundLog.length}}
    <div class="bb-log">{{#each roundLog}}<div class="bb-log-line">{{this}}</div>{{/each}}</div>
    {{/if}}
  </div>
  {{/if}}

</div>
{{else}}
<div class="bb-container bb-empty"><p>No game in progress.</p></div>
{{/if}}
